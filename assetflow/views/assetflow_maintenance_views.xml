<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assetflow_maintenance" model="ir.actions.act_window">
        <name>Maintenance Workflow</name>
        <res_model>assetflow.maintenance</res_model>
        <view_mode>kanban,tree,pivot,graph,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Raise a maintenance request to route asset repairs.
            </p>
        </help>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_maintenance_tree" model="ir.ui.view">
        <name>assetflow.maintenance.tree</name>
        <model>assetflow.maintenance</model>
        <arch type="xml">
            <tree string="Maintenance Requests" decoration-bf="priority == 'critical'" decoration-warning="state == 'pending'" decoration-info="state == 'approved'" decoration-success="state == 'resolved'" decoration-danger="priority == 'critical'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="priority"/>
                <field name="technician_id"/>
                <field name="date_requested"/>
                <field name="date_completed"/>
                <field name="repair_cost"/>
                <field name="state" widget="badge"/>
            </tree>
        </arch>
    </record>

    <!-- Kanban View -->
    <record id="view_assetflow_maintenance_kanban" model="ir.ui.view">
        <name>assetflow.maintenance.kanban</name>
        <model>assetflow.maintenance</model>
        <arch type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="priority"/>
                <field name="technician_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record" style="border-radius: 6px; padding: 10px; margin-bottom: 8px;">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title" style="font-weight: bold;">
                                    <t t-esc="record.name.value"/>
                                </div>
                                <div style="color: #666; font-size: 13px;">
                                    Device: <t t-esc="record.asset_id.value"/>
                                </div>
                                <div style="margin-top: 5px; display: flex; justify-content: space-between;">
                                    <span t-att-class="'badge badge-' + (record.priority.raw_value == 'critical' ? 'danger' : record.priority.raw_value == 'high' ? 'warning' : 'info')">
                                        Priority: <t t-esc="record.priority.value"/>
                                    </span>
                                </div>
                                <div style="margin-top: 10px; font-size: 11px; color: #888;">
                                    <i class="fa fa-user-md"></i> Tech: <t t-esc="record.technician_id.value or 'Unassigned'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_maintenance_form" model="ir.ui.view">
        <name>assetflow.maintenance.form</name>
        <model>assetflow.maintenance</model>
        <arch type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" string="Approve Repair" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'pending')]}" groups="assetflow.group_assetflow_manager"/>
                    <button name="action_start_repair" string="Assign &amp; Start Work" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'approved')]}" groups="assetflow.group_assetflow_manager"/>
                    <button name="action_resolve" string="Mark Resolved" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_reject" string="Reject Request" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'pending')]}" groups="assetflow.group_assetflow_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asset &amp; Severity">
                            <field name="asset_id"/>
                            <field name="priority"/>
                        </group>
                        <group string="Assignments">
                            <field name="technician_id" placeholder="Assign technician..."/>
                            <field name="repair_cost"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="date_requested" readonly="1"/>
                            <field name="date_completed" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Details">
                            <field name="description" placeholder="Provide complete details about the issue..."/>
                        </page>
                        <page string="Resolution Notes" attrs="{'invisible': [('state', '!=', 'resolved')]}">
                            <field name="resolution_notes" placeholder="Technician resolution log details..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>

    <!-- Pivot View -->
    <record id="view_assetflow_maintenance_pivot" model="ir.ui.view">
        <name>assetflow.maintenance.pivot</name>
        <model>assetflow.maintenance</model>
        <arch type="xml">
            <pivot string="Maintenance Analysis">
                <field name="asset_id" type="row"/>
                <field name="state" type="col"/>
                <field name="repair_cost" type="measure"/>
            </pivot>
        </arch>
    </record>

    <!-- Graph View -->
    <record id="view_assetflow_maintenance_graph" model="ir.ui.view">
        <name>assetflow.maintenance.graph</name>
        <model>assetflow.maintenance</model>
        <arch type="xml">
            <graph string="Maintenance Cost Chart" type="bar">
                <field name="asset_id"/>
                <field name="repair_cost" type="measure"/>
            </graph>
        </arch>
    </record>
</odoo>
