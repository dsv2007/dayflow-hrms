<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assetflow_audit" model="ir.actions.act_window">
        <name>Audit Cycles</name>
        <res_model>assetflow.audit</res_model>
        <view_mode>tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Initialize an Audit Cycle.
            </p>
        </help>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_audit_tree" model="ir.ui.view">
        <name>assetflow.audit.tree</name>
        <model>assetflow.audit</model>
        <arch type="xml">
            <tree string="Audit Cycles" decoration-info="state == 'in_progress'" decoration-success="state == 'closed'">
                <field name="name"/>
                <field name="department_id"/>
                <field name="location"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="discrepancy_count" decoration-danger="discrepancy_count > 0" font_weight="bold"/>
                <field name="state" widget="badge"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_audit_form" model="ir.ui.view">
        <name>assetflow.audit.form</name>
        <model>assetflow.audit</model>
        <arch type="xml">
            <form string="Audit Cycle">
                <header>
                    <button name="action_start_audit" string="Start Audit Scope" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_close_audit" string="Reconcile &amp; Close" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'in_progress')]}" groups="assetflow.group_assetflow_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Audit Parameters">
                            <field name="department_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="location" attrs="{'readonly': [('state', '!=', 'draft')]}" placeholder="e.g. Floor 3, Lab A"/>
                        </group>
                        <group string="Auditing Progress">
                            <field name="date_start" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="date_end" readonly="1"/>
                            <field name="auditor_ids" widget="many2many_tags" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="discrepancy_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asset Checklist Lines">
                            <field name="line_ids" attrs="{'readonly': [('state', '=', 'closed')]}">
                                <tree editable="bottom" decoration-danger="verified_condition == 'missing'" decoration-warning="verified_condition == 'damaged'" decoration-success="verified_condition == 'verified'">
                                    <field name="asset_id" readonly="1"/>
                                    <field name="original_state" readonly="1"/>
                                    <field name="verified_condition"/>
                                    <field name="notes" placeholder="Enter audit comments..."/>
                                    <field name="is_discrepancy" invisible="1"/>
                                    <!-- One click wizard action button directly on line -->
                                    <button name="%(action_assetflow_audit_verify_wizard)d" string="Audit Item" type="action" class="btn-primary" icon="fa-check-square" attrs="{'invisible': [('parent.state', '!=', 'in_progress')]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>
</odoo>
