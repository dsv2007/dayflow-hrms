<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Action -->
    <record id="action_assetflow_employee" model="ir.actions.act_window">
        <name>Employee Directory Roles</name>
        <res_model>hr.employee</res_model>
        <view_mode>kanban,tree,form</view_mode>
        <context>{'search_default_active_employees': 1}</context>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Register Employees and promote roles.
            </p>
        </help>
    </record>

    <!-- Inherit tree view -->
    <record id="view_employee_tree_assetflow" model="ir.ui.view">
        <name>hr.employee.tree.assetflow</name>
        <model>hr.employee</model>
        <inherit_id ref="hr.view_employee_tree"/>
        <arch type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="assetflow_role" decoration-info="assetflow_role == 'employee'" decoration-warning="assetflow_role == 'dept_head'" decoration-success="assetflow_role == 'manager'" decoration-danger="assetflow_role == 'admin'" widget="badge"/>
            </xpath>
        </arch>
    </record>

    <!-- Inherit form view -->
    <record id="view_employee_form_assetflow" model="ir.ui.view">
        <name>hr.employee.form.assetflow</name>
        <model>hr.employee</model>
        <inherit_id ref="hr.view_employee_form"/>
        <arch type="xml">
            <!-- Add header buttons for promotion -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_promote_to_dept_head" string="Promote to Head" type="object" class="btn-primary" attrs="{'invisible': [('assetflow_role', '!=', 'employee')]}"/>
                    <button name="action_promote_to_manager" string="Promote to Manager" type="object" class="btn-primary" attrs="{'invisible': [('assetflow_role', '=', 'manager')]}"/>
                    <button name="action_demote_to_employee" string="Demote to Staff" type="object" class="btn-secondary" attrs="{'invisible': [('assetflow_role', '=', 'employee')]}"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="AssetFlow Role Setup">
                    <group>
                        <group string="Role Information">
                            <field name="assetflow_role" decoration-bf="1"/>
                            <field name="is_promoted" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </arch>
    </record>
</odoo>
