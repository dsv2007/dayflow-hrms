<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assetflow_allocation" model="ir.actions.act_window">
        <name>Allocations &amp; Transfers</name>
        <res_model>assetflow.allocation</res_model>
        <view_mode>tree,calendar,pivot,graph,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Allocate assets to employees or departments.
            </p>
        </help>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_allocation_tree" model="ir.ui.view">
        <name>assetflow.allocation.tree</name>
        <model>assetflow.allocation</model>
        <arch type="xml">
            <tree string="Asset Allocations" decoration-warning="state == 'requested'" decoration-info="state == 'approved'" decoration-success="state == 'active'" decoration-danger="is_overdue">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_allocated"/>
                <field name="date_expected_return"/>
                <field name="date_returned"/>
                <field name="is_overdue" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_allocation_form" model="ir.ui.view">
        <name>assetflow.allocation.form</name>
        <model>assetflow.allocation</model>
        <arch type="xml">
            <form string="Asset Allocation">
                <header>
                    <button name="action_approve" string="Approve Transfer" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'requested')]}" groups="assetflow.group_assetflow_dept_head,assetflow.group_assetflow_manager"/>
                    <button name="action_activate" string="Activate Handout" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'approved')]}" groups="assetflow.group_assetflow_manager"/>
                    <button name="%(action_assetflow_return_wizard)d" string="Return Asset" type="action" class="btn-secondary" attrs="{'invisible': [('state', 'not in', ['active', 'overdue'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved,active,returned"/>
                </header>
                <sheet>
                    <group>
                        <group string="Asset Context">
                            <field name="asset_id"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                        <group string="Assignments Details">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="date_allocated"/>
                            <field name="date_expected_return"/>
                            <field name="date_returned" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocation Notes">
                            <field name="notes" placeholder="Initial allocation notes..."/>
                        </page>
                        <page string="Check-In Condition notes" attrs="{'invisible': [('state', '!=', 'returned')]}">
                            <field name="return_condition_notes" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>

    <!-- Calendar View -->
    <record id="view_assetflow_allocation_calendar" model="ir.ui.view">
        <name>assetflow.allocation.calendar</name>
        <model>assetflow.allocation</model>
        <arch type="xml">
            <calendar string="Allocations Calendar" date_start="date_allocated" date_stop="date_expected_return" color="state">
                <field name="asset_id"/>
                <field name="employee_id"/>
            </calendar>
        </arch>
    </record>

    <!-- Pivot View -->
    <record id="view_assetflow_allocation_pivot" model="ir.ui.view">
        <name>assetflow.allocation.pivot</name>
        <model>assetflow.allocation</model>
        <arch type="xml">
            <pivot string="Allocations Analytics">
                <field name="department_id" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </arch>
    </record>

    <!-- Graph View -->
    <record id="view_assetflow_allocation_graph" model="ir.ui.view">
        <name>assetflow.allocation.graph</name>
        <model>assetflow.allocation</model>
        <arch type="xml">
            <graph string="Allocations Chart" type="bar">
                <field name="department_id"/>
                <field name="state"/>
            </graph>
        </arch>
    </record>
</odoo>
