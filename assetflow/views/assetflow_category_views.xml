<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assetflow_category" model="ir.actions.act_window">
        <name>Asset Categories</name>
        <res_model>assetflow.category</res_model>
        <view_mode>tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Asset Categories.
            </p>
        </help>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_category_tree" model="ir.ui.view">
        <name>assetflow.category.tree</name>
        <model>assetflow.category</model>
        <arch type="xml">
            <tree string="Asset Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="lifespan_months"/>
                <field name="warranty_months"/>
                <field name="depreciation_rate"/>
                <field name="is_bookable"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_category_form" model="ir.ui.view">
        <name>assetflow.category.form</name>
        <model>assetflow.category</model>
        <arch type="xml">
            <form string="Asset Category">
                <sheet>
                    <group>
                        <group string="Basic Configuration">
                            <field name="name"/>
                            <field name="code" placeholder="e.g. LAP, VEH, ROOM"/>
                        </group>
                        <group string="Standard Settings">
                            <field name="lifespan_months"/>
                            <field name="warranty_months"/>
                            <field name="depreciation_rate"/>
                            <field name="is_bookable"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </arch>
    </record>
</odoo>
