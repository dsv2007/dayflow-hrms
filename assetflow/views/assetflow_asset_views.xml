<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Action -->
    <record id="action_assetflow_asset" model="ir.actions.act_window">
        <name>Asset Passports</name>
        <res_model>assetflow.asset</res_model>
        <view_mode>kanban,tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new asset to create its Asset Passport.
            </p>
        </help>
    </record>

    <!-- Search View -->
    <record id="view_assetflow_asset_search" model="ir.ui.view">
        <name>assetflow.asset.search</name>
        <model>assetflow.asset</model>
        <arch type="xml">
            <search string="Search Assets">
                <field name="name"/>
                <field name="asset_tag"/>
                <field name="serial_number"/>
                <field name="barcode"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Allocated" name="allocated" domain="[('state', '=', 'allocated')]"/>
                <filter string="Under Maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="High Risk" name="high_risk" domain="[('risk_score', '>=', 60)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Location" name="group_by_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </arch>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_asset_tree" model="ir.ui.view">
        <name>assetflow.asset.tree</name>
        <model>assetflow.asset</model>
        <arch type="xml">
            <tree string="Asset Passports" decoration-info="state == 'available'" decoration-success="state == 'allocated'" decoration-warning="state == 'maintenance'" decoration-danger="state == 'lost'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="condition"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="health_score" widget="progressbar"/>
                <field name="risk_score" decoration-danger="risk_score >= 60"/>
                <field name="state" widget="badge"/>
            </tree>
        </arch>
    </record>

    <!-- Kanban View -->
    <record id="view_assetflow_asset_kanban" model="ir.ui.view">
        <name>assetflow.asset.kanban</name>
        <model>assetflow.asset</model>
        <arch type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="asset_tag"/>
                <field name="condition"/>
                <field name="health_score"/>
                <field name="risk_score"/>
                <field name="employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record" style="border-radius: 8px; border-left: 4px solid #7C5BBA; padding: 10px; margin-bottom: 8px;">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title" style="font-weight: bold; font-size: 15px; color: #4C3C92;">
                                    <t t-esc="record.name.value"/>
                                </div>
                                <div style="color: #666; margin: 3px 0;">
                                    <i class="fa fa-tag"></i> <t t-esc="record.asset_tag.value"/>
                                </div>
                                <div style="margin-top: 5px;">
                                    <span class="badge" style="background-color: #f1f2f6; border-radius: 4px; padding: 2px 6px;">
                                        Condition: <t t-esc="record.condition.value"/>
                                    </span>
                                </div>
                                <div style="margin-top: 8px;">
                                    <div class="progress" style="height: 6px; margin-bottom: 2px;">
                                        <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: ' + record.health_score.raw_value + '%'" t-att-aria-valuenow="record.health_score.raw_value" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <div style="font-size: 11px; color: #888; display: flex; justify-content: space-between;">
                                        <span>Health: <t t-esc="record.health_score.value"/>%</span>
                                        <span t-att-class="record.risk_score.raw_value >= 60 ? 'text-danger' : 'text-muted'">Risk: <t t-esc="record.risk_score.value"/></span>
                                    </div>
                                </div>
                                <div style="margin-top: 10px; display: flex; align-items: center; justify-content: space-between;">
                                    <span t-if="record.employee_id.raw_value" style="font-size: 12px; color: #555;">
                                        <i class="fa fa-user"></i> <t t-esc="record.employee_id.value"/>
                                    </span>
                                    <span t-else="" style="font-size: 11px; color: #999;">Unassigned</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </arch>
    </record>

    <!-- Form View (Asset Passport) -->
    <record id="view_assetflow_asset_form" model="ir.ui.view">
        <name>assetflow.asset.form</name>
        <model>assetflow.asset</model>
        <arch type="xml">
            <form string="Asset Passport">
                <header>
                    <button name="action_generate_qr" string="Generate QR Passport" type="object" class="btn-primary"/>
                    <button name="%(action_assetflow_transfer_wizard)d" string="Transfer Asset" type="action" class="btn-secondary" attrs="{'invisible': [('state', 'not in', ['available', 'allocated', 'overdue'])]}"/>
                    <button name="%(action_assetflow_return_wizard)d" string="Process Return" type="action" class="btn-secondary" attrs="{'invisible': [('state', 'not in', ['allocated', 'overdue'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,allocated,maintenance"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_generate_qr" type="object" icon="fa-qrcode">
                            <div class="o_stat_info">
                                <span class="o_stat_text">QR Code</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="%(action_assetflow_transfer_wizard)d" type="action" icon="fa-exchange">
                            <div class="o_stat_info">
                                <field name="allocation_count" widget="statinfo" string="Allocations"/>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="action_generate_qr" type="object" icon="fa-wrench">
                            <div class="o_stat_info">
                                <field name="maintenance_count" widget="statinfo" string="Repairs"/>
                            </div>
                        </button>
                    </div>

                    <!-- Header Titles -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Asset Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. MacBook Pro 16 Inch"/>
                        </h1>
                        <h3>
                            <field name="asset_tag" readonly="1" class="oe_inline"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Handout Assignments">
                            <field name="employee_id" readonly="1" options="{'no_open': True}"/>
                            <field name="department_id" readonly="1" options="{'no_open': True}"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Security &amp; QR Identity">
                            <field name="qr_code_image" widget="image" class="oe_avatar" style="max-width: 100px; max-height: 100px;" readonly="1"/>
                            <field name="barcode" placeholder="Scan Barcode Number..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Asset Passport Info">
                            <group>
                                <group string="Acquisition &amp; Financials">
                                    <field name="category_id"/>
                                    <field name="serial_number"/>
                                    <field name="acquisition_date"/>
                                    <field name="acquisition_cost"/>
                                </group>
                                <group string="Condition &amp; Criticality">
                                    <field name="condition"/>
                                    <field name="asset_criticality"/>
                                    <field name="location"/>
                                    <field name="is_bookable" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Asset Location Map">
                            <div class="o_assetflow_location_map" style="padding: 15px; background-color: #f8f9fa; border-radius: 8px; border: 1px solid #dee2e6;">
                                <h4>Interactive Office Layout Reference</h4>
                                <div style="position: relative; width: 100%; height: 250px; background: #e9ecef; border: 2px dashed #6c757d; border-radius: 4px; display: flex; justify-content: center; align-items: center; margin-bottom: 10px;">
                                    <!-- Render Simulated Map overlay -->
                                    <svg width="100%" height="100%" style="position: absolute; top:0; left:0;">
                                        <!-- Floor map visual background rooms -->
                                        <rect x="10" y="10" width="180" height="100" fill="#ced4da" stroke="#495057" stroke-width="2"/>
                                        <text x="20" y="30" fill="#212529" font-weight="bold">IT Department</text>
                                        
                                        <rect x="200" y="10" width="180" height="100" fill="#ced4da" stroke="#495057" stroke-width="2"/>
                                        <text x="210" y="30" fill="#212529" font-weight="bold">Conference B2</text>
                                        
                                        <rect x="10" y="130" width="370" height="100" fill="#ced4da" stroke="#495057" stroke-width="2"/>
                                        <text x="20" y="150" fill="#212529" font-weight="bold">Operations Hall</text>

                                        <!-- Highlight current asset location coordinate -->
                                        <circle t-att-cx="fields.location_x" t-att-cy="fields.location_y" r="8" fill="#7C5BBA" stroke="#fff" stroke-width="2"/>
                                        <text x="110" y="80" fill="#7C5BBA" font-size="12" font-weight="bold">📌 Device Location</text>
                                    </svg>
                                    <span style="z-index: 100; font-size: 14px; font-weight: bold; color: #495057;">Floor Map Grid Vector Reference</span>
                                </div>
                                <group>
                                    <group>
                                        <field name="location_x"/>
                                    </group>
                                    <group>
                                        <field name="location_y"/>
                                    </group>
                                </group>
                            </div>
                        </page>

                        <page string="Intelligent Recommendations">
                            <group>
                                <group string="AI Performance Index">
                                    <field name="remaining_useful_life" readonly="1"/>
                                    <field name="health_score" widget="progressbar" readonly="1"/>
                                    <field name="risk_score" readonly="1" decoration-danger="risk_score >= 60" decoration-warning="risk_score &gt;= 30 and risk_score &lt; 60" decoration-success="risk_score &lt; 30"/>
                                </group>
                                <group string="Schedule Forecast">
                                    <field name="next_maintenance_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Child Components">
                            <field name="child_ids">
                                <tree>
                                    <field name="asset_tag"/>
                                    <field name="name"/>
                                    <field name="condition"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Asset Timeline">
                            <field name="timeline_html" widget="html" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>
</odoo>
