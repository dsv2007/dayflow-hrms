<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Action -->
    <record id="action_assetflow_department" model="ir.actions.act_window">
        <name>Department Gamification Setup</name>
        <res_model>hr.department</res_model>
        <view_mode>tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Departments and view their gamification metrics.
            </p>
        </help>
    </record>

    <!-- Inherit tree view -->
    <record id="view_department_tree_assetflow" model="ir.ui.view">
        <name>hr.department.tree.assetflow</name>
        <model>hr.department</model>
        <inherit_id ref="hr.view_department_tree"/>
        <arch type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="gamification_score" decoration-bf="1" decoration-success="gamification_score >= 100" decoration-warning="gamification_score &lt; 100" widget="badge"/>
                <field name="efficiency_tier" decoration-info="efficiency_tier == 'gold'" decoration-success="efficiency_tier == 'platinum'" widget="badge"/>
            </xpath>
        </arch>
    </record>

    <!-- Inherit form view -->
    <record id="view_department_form_assetflow" model="ir.ui.view">
        <name>hr.department.form.assetflow</name>
        <model>hr.department</model>
        <inherit_id ref="hr.view_department_form"/>
        <arch type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_recalculate_gamification" string="Recalculate Score" type="object" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//group" position="after">
                <group string="AssetFlow Gamification &amp; KPIs">
                    <group>
                        <field name="gamification_score" readonly="1"/>
                        <field name="efficiency_tier" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </arch>
    </record>
</odoo>
