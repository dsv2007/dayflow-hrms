<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_assetflow_booking" model="ir.actions.act_window">
        <name>Resource Bookings</name>
        <res_model>assetflow.booking</res_model>
        <view_mode>calendar,tree,pivot,graph,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Book a shared resource or conference room.
            </p>
        </help>
    </record>

    <!-- Tree View -->
    <record id="view_assetflow_booking_tree" model="ir.ui.view">
        <name>assetflow.booking.tree</name>
        <model>assetflow.booking</model>
        <arch type="xml">
            <tree string="Resource Bookings" decoration-info="state == 'upcoming'" decoration-success="state == 'ongoing'" decoration-muted="state == 'completed'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_booking_form" model="ir.ui.view">
        <name>assetflow.booking.form</name>
        <model>assetflow.booking</model>
        <arch type="xml">
            <form string="Resource Booking">
                <header>
                    <button name="action_check_in" string="Check In" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'upcoming')]}"/>
                    <button name="action_complete" string="Complete Session" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'ongoing')]}"/>
                    <button name="action_cancel" string="Cancel Booking" type="object" class="btn-secondary" attrs="{'invisible': [('state', 'in', ['completed', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="upcoming,ongoing,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Resource &amp; Booker">
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Time Slot">
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                    </group>
                    <group string="Purpose">
                        <field name="notes" placeholder="Describe booking objective (e.g. Board Meeting)..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>

    <!-- Calendar View -->
    <record id="view_assetflow_booking_calendar" model="ir.ui.view">
        <name>assetflow.booking.calendar</name>
        <model>assetflow.booking</model>
        <arch type="xml">
            <calendar string="Bookings Timeline" date_start="start_datetime" date_stop="end_datetime" color="asset_id" mode="week">
                <field name="asset_id"/>
                <field name="employee_id"/>
            </calendar>
        </arch>
    </record>

    <!-- Pivot View -->
    <record id="view_assetflow_booking_pivot" model="ir.ui.view">
        <name>assetflow.booking.pivot</name>
        <model>assetflow.booking</model>
        <arch type="xml">
            <pivot string="Resource Utilization Analysis">
                <field name="asset_id" type="row"/>
                <field name="state" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </arch>
    </record>

    <!-- Graph View -->
    <record id="view_assetflow_booking_graph" model="ir.ui.view">
        <name>assetflow.booking.graph</name>
        <model>assetflow.booking</model>
        <arch type="xml">
            <graph string="Resource Utilization Chart" type="bar">
                <field name="asset_id"/>
                <field name="state"/>
            </graph>
        </arch>
    </record>
</odoo>
