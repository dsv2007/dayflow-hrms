<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Board Form View -->
    <record id="view_assetflow_dashboard_form" model="ir.ui.view">
        <name>assetflow.dashboard.form</name>
        <model>board.board</model>
        <arch type="xml">
            <form string="AssetFlow Command Center">
                <board style="2-1">
                    <column>
                        <!-- Large Columns: Operational Metrics -->
                        <action name="%(action_assetflow_asset)d" string="Asset Directory Snapshot" view_mode="kanban"/>
                        <action name="%(action_assetflow_maintenance)d" string="Maintenance Repair Queue" view_mode="tree"/>
                        <action name="%(action_assetflow_allocation)d" string="Allocations Breakdown" view_mode="pivot"/>
                    </column>
                    <column>
                        <!-- Small Column: Live Logs & Notifications -->
                        <action name="%(action_assetflow_notification)d" string="Notification Center" view_mode="tree"/>
                        <action name="%(action_assetflow_booking)d" string="Bookings Timeline" view_mode="calendar"/>
                    </column>
                </board>
            </form>
        </arch>
    </record>

    <!-- Dashboard Action -->
    <record id="action_assetflow_dashboard" model="ir.actions.act_window">
        <name>Command Center</name>
        <res_model>board.board</res_model>
        <view_mode>form</view_mode>
        <usage>menu</usage>
        <view_id ref="view_assetflow_dashboard_form"/>
    </record>
</odoo>
