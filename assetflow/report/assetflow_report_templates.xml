<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_asset_passport">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
                        
                        <!-- Header Section -->
                        <div class="row mt32 mb32" style="border-bottom: 2px solid #7C5BBA; padding-bottom: 10px;">
                            <div class="col-8">
                                <h2 style="color: #7C5BBA;">Asset Passport</h2>
                                <h4><t t-out="o.name"/></h4>
                                <strong>Tag:</strong> <t t-out="o.asset_tag"/><br/>
                                <strong>Serial:</strong> <t t-out="o.serial_number or 'N/A'"/>
                            </div>
                            <div class="col-4 text-right">
                                <img t-if="o.qr_code_image" t-att-src="image_data_uri(o.qr_code_image)" style="max-height: 100px;" alt="QR Code"/>
                            </div>
                        </div>

                        <!-- Info Grid -->
                        <div class="row mb32">
                            <div class="col-6">
                                <strong>Category:</strong> <t t-out="o.category_id.name"/><br/>
                                <strong>Current Status:</strong> <t t-out="dict(o.fields_get(allfields=['state'])['state']['selection'])[o.state]"/><br/>
                                <strong>Acquisition Date:</strong> <t t-out="o.acquisition_date"/><br/>
                                <strong>Acquisition Cost:</strong> <t t-out="o.acquisition_cost" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                            </div>
                            <div class="col-6">
                                <strong>Assigned Employee:</strong> <t t-out="o.employee_id.name or 'None'"/><br/>
                                <strong>Assigned Department:</strong> <t t-out="o.department_id.name or 'None'"/><br/>
                                <strong>Location:</strong> <t t-out="o.location or 'N/A'"/><br/>
                            </div>
                        </div>

                        <!-- Intelligence Metrics -->
                        <div class="row mb32" style="background-color: #f8f9fa; padding: 15px; border-radius: 5px;">
                            <div class="col-12">
                                <h5 style="color: #495057;">Intelligence Metrics</h5>
                            </div>
                            <div class="col-4">
                                <strong>Health Score:</strong> <t t-out="o.health_score"/>%
                            </div>
                            <div class="col-4">
                                <strong>Risk Score:</strong> <t t-out="o.risk_score"/>/100
                            </div>
                            <div class="col-4">
                                <strong>Useful Life:</strong> <t t-out="o.remaining_useful_life"/> Months
                            </div>
                        </div>

                        <!-- Statistics -->
                        <div class="row mb32">
                            <div class="col-12">
                                <h5 style="color: #495057;">Usage Statistics</h5>
                                <ul>
                                    <li><strong>Total Allocations:</strong> <t t-out="o.allocation_count"/></li>
                                    <li><strong>Total Maintenances:</strong> <t t-out="o.maintenance_count"/></li>
                                    <li><strong>Total Bookings:</strong> <t t-out="o.booking_count"/></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
