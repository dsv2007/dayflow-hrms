<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="view_assetflow_bi_report_pivot" model="ir.ui.view">
        <field name="name">assetflow.bi.report.pivot</field>
        <field name="model">assetflow.bi.report</field>
        <field name="arch" type="xml">
            <pivot string="Asset Intelligence Insights" disable_linking="True" sample="1">
                <field name="department_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="asset_state" type="col"/>
                <field name="health_score" type="measure"/>
                <field name="risk_score" type="measure"/>
                <field name="acquisition_cost" type="measure"/>
                <field name="total_repair_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_assetflow_bi_report_graph" model="ir.ui.view">
        <field name="name">assetflow.bi.report.graph</field>
        <field name="model">assetflow.bi.report</field>
        <field name="arch" type="xml">
            <graph string="Asset Intelligence Insights" sample="1">
                <field name="category_id"/>
                <field name="risk_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_assetflow_bi_report_search" model="ir.ui.view">
        <field name="name">assetflow.bi.report.search</field>
        <field name="model">assetflow.bi.report</field>
        <field name="arch" type="xml">
            <search string="Search Asset Insights">
                <field name="asset_id"/>
                <field name="department_id"/>
                <field name="category_id"/>
                <filter string="High Risk" name="high_risk" domain="[('risk_score', '&gt;=', 70)]"/>
                <filter string="Poor Health" name="poor_health" domain="[('health_score', '&lt;=', 40)]"/>
                <group expand="1" string="Group By">
                    <filter string="Department" name="groupby_department" context="{'group_by':'department_id'}"/>
                    <filter string="Category" name="groupby_category" context="{'group_by':'category_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by':'asset_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_assetflow_bi_report" model="ir.actions.act_window">
        <field name="name">Executive BI Dashboard</field>
        <field name="res_model">assetflow.bi.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_assetflow_bi_report_search"/>
        <field name="context">{'search_default_groupby_department': 1}</field>
    </record>

    <!-- Menu Item (Will go under Reporting) -->
    <menuitem id="menu_assetflow_bi_report"
              name="Executive Insights"
              parent="menu_assetflow_reports"
              action="action_assetflow_bi_report"
              sequence="10"/>
</odoo>
