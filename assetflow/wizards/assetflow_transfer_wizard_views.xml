<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_transfer_wizard_form" model="ir.ui.view">
        <name>assetflow.transfer.wizard.form</name>
        <model>assetflow.transfer.wizard</model>
        <arch type="xml">
            <form string="Request Asset Transfer">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id" readonly="1"/>
                            <field name="current_employee_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="new_employee_id" placeholder="Select Employee..."/>
                            <field name="new_department_id" placeholder="Select Department..."/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Reason for this transfer request..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_transfer" string="Request Transfer" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </arch>
    </record>

    <record id="action_assetflow_transfer_wizard" model="ir.actions.act_window">
        <name>Transfer Asset</name>
        <res_model>assetflow.transfer.wizard</res_model>
        <view_mode>form</view_mode>
        <target>new</target>
    </record>
</odoo>
