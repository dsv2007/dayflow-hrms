<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Update Asset Metrics Daily -->
        <record id="ir_cron_update_intelligence_metrics" model="ir.cron">
            <field name="name">AssetFlow: Update Asset Intelligence Metrics</field>
            <field name="model_id" ref="model_assetflow_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_intelligence_metrics()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check Overdue Allocations Daily -->
        <record id="ir_cron_check_overdue_allocations" model="ir.cron">
            <field name="name">AssetFlow: Check Overdue Allocations</field>
            <field name="model_id" ref="model_assetflow_allocation"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_allocations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
