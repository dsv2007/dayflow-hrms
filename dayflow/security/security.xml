<odoo>
    <data noupdate="1">
        <!-- Category for Dayflow HRMS -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege for Dayflow HRMS -->
        <record id="privilege_dayflow" model="res.groups.privilege">
            <field name="name">Dayflow Access</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_dayflow"/>
        </record>

        <!-- Standard Employee Group -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_dayflow"/>
            <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <!-- HR Officer Group -->
        <record id="group_dayflow_hr" model="res.groups">
            <field name="name">HR Officer</field>
            <field name="privilege_id" ref="privilege_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
        </record>

        <!-- Admin Group -->
        <record id="group_dayflow_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_hr'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Link system administration settings to Dayflow Admin -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_dayflow_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <!-- Employee can read/write their own attendance -->
        <record id="rule_dayflow_attendance_employee" model="ir.rule">
            <field name="name">Employee Attendance access</field>
            <field name="model_id" ref="model_dayflow_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR / Admin can manage all attendance -->
        <record id="rule_dayflow_attendance_hr" model="ir.rule">
            <field name="name">HR Attendance access</field>
            <field name="model_id" ref="model_dayflow_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        </record>

        <!-- Employee can read/create/write their own leaves in draft/pending status -->
        <record id="rule_dayflow_leave_employee" model="ir.rule">
            <field name="name">Employee Leave access</field>
            <field name="model_id" ref="model_dayflow_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- HR / Admin can access all leaves -->
        <record id="rule_dayflow_leave_hr" model="ir.rule">
            <field name="name">HR Leave access</field>
            <field name="model_id" ref="model_dayflow_leave"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        </record>

        <!-- Employee can read own payroll record -->
        <record id="rule_dayflow_payroll_employee" model="ir.rule">
            <field name="name">Employee Payroll access</field>
            <field name="model_id" ref="model_dayflow_payroll"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR / Admin can access all payrolls -->
        <record id="rule_dayflow_payroll_hr" model="ir.rule">
            <field name="name">HR Payroll access</field>
            <field name="model_id" ref="model_dayflow_payroll"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        </record>

        <!-- Employee can read own hr.employee profile -->
        <record id="rule_dayflow_employee_read_own" model="ir.rule">
            <field name="name">Employee Profile access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- HR / Admin can manage all employee profiles -->
        <record id="rule_dayflow_employee_hr" model="ir.rule">
            <field name="name">HR Employee Profile access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        </record>
    </data>
</odoo>
