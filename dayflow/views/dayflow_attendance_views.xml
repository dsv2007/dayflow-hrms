<odoo>
    <record id="view_dayflow_attendance_tree" model="ir.ui.view">
        <field name="name">dayflow.attendance.tree</field>
        <field name="model">dayflow.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Logs">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_attendance_form" model="ir.ui.view">
        <field name="name">dayflow.attendance.form</field>
        <field name="model">dayflow.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dayflow_attendance_search" model="ir.ui.view">
        <field name="name">dayflow.attendance.search</field>
        <field name="model">dayflow.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="employee_id"/>
                <field name="date"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="present" string="Present" domain="[('status', '=', 'present')]"/>
                <filter name="absent" string="Absent" domain="[('status', '=', 'absent')]"/>
                <group>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by':'date'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dayflow_attendance" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">dayflow.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dayflow_attendance_search"/>
    </record>
</odoo>
