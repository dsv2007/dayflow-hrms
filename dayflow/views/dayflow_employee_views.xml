<odoo>
    <record id="view_employee_form_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dayflow HRMS Settings" name="dayflow_settings">
                    <group>
                        <group>
                            <field name="dayflow_role"/>
                            <field name="joining_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
