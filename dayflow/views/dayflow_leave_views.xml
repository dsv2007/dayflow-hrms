<odoo>
    <record id="view_dayflow_leave_tree" model="ir.ui.view">
        <field name="name">dayflow.leave.tree</field>
        <field name="model">dayflow.leave</field>
        <field name="arch" type="xml">
            <list string="Leave Requests" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_leave_form" model="ir.ui.view">
        <field name="name">dayflow.leave.form</field>
        <field name="model">dayflow.leave</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'" groups="dayflow.group_dayflow_hr"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'" groups="dayflow.group_dayflow_hr" context="{'default_rejection_reason': 'Rejected by HR'}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Approver Actions" invisible="state not in ['approved', 'rejected']">
                        <field name="approver_id"/>
                        <field name="approval_date"/>
                        <field name="approver_comments" readonly="state in ['approved', 'rejected']"/>
                        <field name="rejection_reason" invisible="state != 'rejected'" readonly="state == 'rejected'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_dayflow_leave_search" model="ir.ui.view">
        <field name="name">dayflow.leave.search</field>
        <field name="model">dayflow.leave</field>
        <field name="arch" type="xml">
            <search string="Search Leaves">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <filter name="pending" string="Pending Approvals" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by':'state'}"/>
                    <filter string="Leave Type" name="group_type" domain="[]" context="{'group_by':'leave_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dayflow_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">dayflow.leave</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dayflow_leave_search"/>
    </record>
</odoo>
