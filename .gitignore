# Ignore everything by default in the workspace root
/*

# Allow tracking of this .gitignore file
!/.gitignore

# Allow tracking of the root README.md file
!/README.md

# Allow tracking of the Dayflow HRMS Odoo backend module
!/dayflow/

# Allow tracking of the Dayflow HRMS React frontend web app
!/dayflow-web/

# Nested ignore rules (ignores build outputs and caches inside allowed folders)
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/node_modules/
**/dist/
**/.env
**/.env.*
